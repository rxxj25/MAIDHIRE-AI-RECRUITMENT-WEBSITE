# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Public URL of this API (used to build absolute file URLs)
API_PUBLIC_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/maidhire?schema=public

# --- Auth ---
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# Cookie settings: set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Seeded admin (only used by `npm run db:seed`)
ADMIN_EMAIL=admin@maidhire.com
ADMIN_PASSWORD=ChangeMe!2026

# --- Storage ---
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3-compatible (Cloudflare R2, AWS S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Email (Resend). Leave RESEND_API_KEY empty to log emails to console. ---
RESEND_API_KEY=
EMAIL_FROM="MaidHire <no-reply@maidhire.com>"
NOTIFY_EMAIL=ops@maidhire.com
