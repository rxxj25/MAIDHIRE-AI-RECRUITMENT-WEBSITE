# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Public URL of this API (used to build absolute file URLs)
API_PUBLIC_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/maidhire?schema=public

# --- Auth ---
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# Cookie settings: set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Seeded admin (only used by `npm run db:seed`)
ADMIN_EMAIL=admin@maidhire.com
ADMIN_PASSWORD=ChangeMe!2026

# --- Storage ---
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3-compatible (Cloudflare R2, AWS S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Email (Resend). Leave RESEND_API_KEY empty to log emails to console. ---
RESEND_API_KEY=
EMAIL_FROM="MaidHire <no-reply@maidhire.com>"
NOTIFY_EMAIL=ops@maidhire.com

# --- AI chatbot (Gemini). Leave empty to disable the chatbot endpoint. ---
GEMINI_API_KEY=

# --- AI phone receptionist (Twilio Voice -> Langflow flow "MaidHire Voice Receptionist" -> Groq) ---
# Base URL of the running Langflow server (the desktop app's backend, by default).
LANGFLOW_API_URL=http://localhost:7860
# Langflow app > Settings > Langflow API Keys > Add New.
LANGFLOW_API_KEY=
# The flow's id (Langflow app > open the flow > copy from the URL, or via the API: GET /api/v1/flows/).
LANGFLOW_FLOW_ID=
# From the Twilio Console (console.twilio.com) > Account > API keys & tokens > Auth Token.
# Verifies that /api/voice/* webhooks really came from Twilio. Leave empty only for local dev.
TWILIO_AUTH_TOKEN=

# --- Vapi.ai (alternative to Twilio for the phone channel; calls /api/vapi/chat/completions) ---
# Random secret shared with Vapi's assistant config (Model > Custom LLM > Headers: Authorization: Bearer <this>).
# Generate with `openssl rand -hex 24`. Leave empty only for local dev.
VAPI_SERVER_SECRET=
